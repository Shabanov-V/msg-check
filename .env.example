# Telegram API credentials (from https://my.telegram.org)
TELEGRAM_API_ID=your_telegram_api_id
TELEGRAM_API_HASH=your_telegram_api_hash

# OpenRouter API key (from https://openrouter.ai)
OPENROUTER_API_KEY=your_openrouter_api_key

# LLM model to use (optional, defaults to google/gemini-2.0-flash-exp:free)
# LLM_MODEL=google/gemini-2.0-flash-exp:free

# Path to the Phase 1 prompt file (classification)
BASE_PROMPT_FILE=base_phase1.prompt

# Path to the Phase 2 prompt file (event extraction, optional, defaults to base_phase2.prompt)
# PHASE2_PROMPT_FILE=base_phase2.prompt

# Telegram dialog filter name to monitor (must exist in your Telegram folders)
TARGET_DIALOG_FILTER=your_filter_name

# Telegram channel ID for forwarding matched messages
OUTPUT_DIALOG_ID=your_output_channel_id

# Telegram channel ID for error/status reports
ERROR_DIALOG_ID=your_error_channel_id

# Google Calendar ID for event creation
CALENDAR_ID=your_calendar_id@group.calendar.google.com

# Timezone for message datetime conversion (optional, defaults to Europe/Madrid)
# TIMEZONE=Europe/Madrid

# --- WhatsApp via WAHA (optional) ---
# WAHA base URL (e.g., http://localhost:3000). If not set, WhatsApp is disabled.
# WAHA_API_URL=http://localhost:3000

# WAHA API key for authentication (required if WAHA_API_URL is set)
# WAHA_API_KEY=your_waha_api_key

# WAHA session name (optional, defaults to "default")
# WAHA_SESSION=default

# WhatsApp label name to filter chats (required if WAHA_API_URL is set)
# WHATSAPP_TARGET_LABEL=Monitor
